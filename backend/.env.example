# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/kra-monitoring

# JWT Secret Key (REQUIRED for production)
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here_min_32_characters

# Server Port (optional, defaults to 5000)
PORT=5000

# Frontend origin(s) allowed by CORS in production
# Comma-separated if you have multiple domains
# Example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=development
