{
  "name": "kra-monitoring-backend",
  "version": "1.0.0",
  "description": "KRA Monitoring Data Entry Form - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedData.js",
    "add-sample": "node seeds/addSampleEntries.js",
    "wipe-entries": "node seeds/wipeKraEntries.js DELETE_KRA_ENTRIES",
    "wipe-users": "node scripts/wipeAllUsers.js",
    "setup-one-corp-logins": "node scripts/setupOneCorporationLogins.js",
    "setup-all-hierarchy-logins": "node scripts/setupAllHierarchyLogins.js",
    "export-credentials-xl": "node scripts/exportAllUserCredentialsXl.js",
    "rebuild-users-xl": "npm run wipe-users -- DELETE_ALL_USERS && npm run setup-all-hierarchy-logins && npm run export-credentials-xl"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
